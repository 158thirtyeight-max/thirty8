{
  "$schema": "Thirty8 design tokens — platform-neutral source of truth. Flutter (packages/design_system) and Next.js (apps/admin_web) both derive their theme values from this file. See DESIGN_SYSTEM.md for usage rules.",
  "colors": {
    "primary": "#6D28D9",
    "primaryDark": "#4C1D95",
    "primaryLight": "#C4B5FD",
    "secondary": "#4F46E5",
    "accent": "#F59E0B",
    "background": "#F8F7FC",
    "backgroundDark": "#0B0712",
    "surface": "#FFFFFF",
    "surfaceDark": "#150F23",
    "surfaceElevated": "#FFFFFF",
    "surfaceElevatedDark": "#1D1530",
    "card": "#FFFFFF",
    "cardDark": "#1D1530",
    "textPrimary": "#1E1B2E",
    "textPrimaryDark": "#F5F3FA",
    "textSecondary": "#615C73",
    "textSecondaryDark": "#B3ACC6",
    "textTertiary": "#9B96AC",
    "textTertiaryDark": "#7C7690",
    "border": "#E7E3F0",
    "borderDark": "#2D2542",
    "divider": "#EFECF7",
    "dividerDark": "#251D3A",
    "success": "#10B981",
    "warning": "#F59E0B",
    "error": "#EF4444",
    "info": "#3B82F6",
    "disabled": "#C9C5D6",
    "disabledDark": "#4A4460"
  },
  "typography": {
    "fontFamily": "Inter",
    "scale": {
      "display": { "size": 34, "weight": 700, "lineHeight": 1.15, "letterSpacing": -0.5 },
      "h1": { "size": 28, "weight": 700, "lineHeight": 1.2, "letterSpacing": -0.3 },
      "h2": { "size": 24, "weight": 700, "lineHeight": 1.25, "letterSpacing": -0.2 },
      "h3": { "size": 20, "weight": 600, "lineHeight": 1.3, "letterSpacing": 0 },
      "h4": { "size": 18, "weight": 600, "lineHeight": 1.35, "letterSpacing": 0 },
      "bodyLarge": { "size": 16, "weight": 400, "lineHeight": 1.5, "letterSpacing": 0 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.5, "letterSpacing": 0 },
      "bodySmall": { "size": 13, "weight": 400, "lineHeight": 1.45, "letterSpacing": 0 },
      "caption": { "size": 12, "weight": 400, "lineHeight": 1.4, "letterSpacing": 0.1 },
      "button": { "size": 15, "weight": 600, "lineHeight": 1.2, "letterSpacing": 0.1 },
      "label": { "size": 13, "weight": 500, "lineHeight": 1.3, "letterSpacing": 0.1 },
      "navLabel": { "size": 12, "weight": 500, "lineHeight": 1.2, "letterSpacing": 0.1 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48,
    "3xl": 64
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px rgba(76, 29, 149, 0.06)",
    "md": "0 4px 12px rgba(76, 29, 149, 0.10)",
    "lg": "0 12px 32px rgba(76, 29, 149, 0.14)"
  }
}
